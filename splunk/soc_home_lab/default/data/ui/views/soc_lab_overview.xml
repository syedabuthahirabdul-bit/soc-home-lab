<form version="1.1">
  <label>SOC Home Lab - Overview</label>
  <fieldset submitButton="false">
    <input type="time" token="t">
      <label>Time</label>
      <default>
        <earliest>-24h</earliest>
        <latest>now</latest>
      </default>
    </input>
  </fieldset>
  <row>
    <panel>
      <title>Sysmon events by EventCode</title>
      <chart>
        <search>
          <query>`sysmon` | stats count by EventCode</query>
          <earliest>$t.earliest$</earliest>
          <latest>$t.latest$</latest>
        </search>
        <option name="charting.chart">bar</option>
      </chart>
    </panel>
    <panel>
      <title>Top processes started (EID 1)</title>
      <table>
        <search>
          <query>`sysmon` EventCode=1 | stats count by Image | sort - count | head 10</query>
          <earliest>$t.earliest$</earliest>
          <latest>$t.latest$</latest>
        </search>
      </table>
    </panel>
  </row>
  <row>
    <panel>
      <title>Encoded PowerShell (T1059.001)</title>
      <table>
        <search>
          <query>`sysmon` EventCode=1 Image="*\\powershell.exe" (CommandLine="*-enc*" OR CommandLine="*-EncodedCommand*") | table _time, User, ParentImage, CommandLine</query>
          <earliest>$t.earliest$</earliest>
          <latest>$t.latest$</latest>
        </search>
      </table>
    </panel>
  </row>
  <row>
    <panel>
      <title>Nmap executions (T1046)</title>
      <table>
        <search>
          <query>`sysmon` EventCode=1 Image="*\\nmap.exe" | table _time, User, ParentImage, CommandLine</query>
          <earliest>$t.earliest$</earliest>
          <latest>$t.latest$</latest>
        </search>
      </table>
    </panel>
    <panel>
      <title>Top network destinations (EID 3)</title>
      <table>
        <search>
          <query>`sysmon` EventCode=3 | stats count by Image, DestinationIp, DestinationPort | sort - count | head 15</query>
          <earliest>$t.earliest$</earliest>
          <latest>$t.latest$</latest>
        </search>
      </table>
    </panel>
  </row>
</form>
